# Copy to .env.local for `npm run dev`, and add the same keys in Vercel → Project → Settings → Environment Variables.
# Firebase web app config (Project settings → General → Your apps → Web app). Not secret.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_APP_ID=
# Service account JSON on ONE line (Project settings → Service accounts → Generate new private key). SECRET.
FIREBASE_SERVICE_ACCOUNT=
# Set to 0 to stop mixing the 420 sample users into Analysis.
SAMPLE_ANALYSIS=1
