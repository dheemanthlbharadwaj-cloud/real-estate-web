{
  "hosting": {
    "target": "site",
    "public": "public",
    "cleanUrls": false,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/rank.html",
        "destination": "/rank",
        "type": 301
      },
      {
        "source": "/shortlist.html",
        "destination": "/shortlist",
        "type": 301
      },
      {
        "source": "/archive/analytics.html",
        "destination": "/archive/analytics",
        "type": 301
      },
      {
        "source": "/archive/home.html",
        "destination": "/archive/home",
        "type": 301
      },
      {
        "source": "/index.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/analysis",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/analytics",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/account",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/archive/account",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/archive/dashboard",
        "destination": "/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://www.googletagmanager.com; style-src 'self' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.google-analytics.com https://www.googletagmanager.com https://www.google.com; connect-src 'self' https://script.google.com https://script.googleusercontent.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/data/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      },
      {
        "source": "/img/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, immutable"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/rank",
        "destination": "/rank.html"
      },
      {
        "source": "/shortlist",
        "destination": "/shortlist.html"
      },
      {
        "source": "/archive/analytics",
        "destination": "/archive/analytics.html"
      },
      {
        "source": "/archive/home",
        "destination": "/archive/home.html"
      }
    ]
  }
}
